<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  <!-- The end of a rest has to ring on time with the screen locked, which only an
       exact alarm does. Android 12 grants SCHEDULE_EXACT_ALARM on install; from
       13 on, USE_EXACT_ALARM is the one granted without a trip to the settings. -->
  <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
  <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

  <!-- A restart clears every alarm; the reminders are set again when it is over. -->
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

  <application>
    <receiver android:name="expo.modules.workoutnotifications.RestEndReceiver" android:exported="false" />
    <receiver android:name="expo.modules.workoutnotifications.ReminderReceiver" android:exported="false" />

    <!-- Exported because the system is the one that sends these. -->
    <receiver android:name="expo.modules.workoutnotifications.BootReceiver" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
      </intent-filter>
    </receiver>
  </application>
</manifest>
